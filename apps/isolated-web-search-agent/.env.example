FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4.1-mini"
# Provider mode: "mock" returns canned findings offline; "http" hits the real
# public web (keyless DuckDuckGo Instant Answer search + SSRF-hardened fetch).
WEB_RESEARCH_MODE="mock"
# Operator egress ceiling: comma-separated public hostnames the subagent may reach.
# Leave empty to allow any public HTTPS host; set it to hard-limit egress.
WEB_RESEARCH_ALLOWED_DOMAINS=""
# Raise the subprocess timeout when using http mode (search + several fetches).
WEB_RESEARCH_SUBPROCESS_TIMEOUT_SECONDS="30"
WEB_RESEARCH_MAX_ITERATIONS="5"
WEB_RESEARCH_MAX_FETCHES="8"
WEB_RESEARCH_MAX_FINDINGS_CHARS="12000"
# http-mode fetch tuning (used only when WEB_RESEARCH_MODE="http").
WEB_RESEARCH_HTTP_TIMEOUT_SECONDS="15"
WEB_RESEARCH_MAX_REDIRECTS="3"
WEB_RESEARCH_MAX_BYTES="200000"
WEB_RESEARCH_USER_AGENT="isolated-web-search-agent/1.0 (+https://github.com/)"