{
  "catalogName": "Isolated Web Search Agent Project",
  "version": "0.1.0",
  "description": "A hosted Foundry main-agent harness with an isolated read-only web research subagent based on the web-search isolation architecture spec.",
  "sourceSpec": "C:\\Users\\fbabaei\\Downloads\\isolated-web-search-architecture.html",
  "agents": [
    {
      "id": "main-agent-harness",
      "name": "Main Agent Harness",
      "runtime": "Foundry hosted agent",
      "path": "src/isolated-web-search-agent/main.py",
      "trustLevel": "privileged",
      "capabilities": [
        "Foundry model orchestration",
        "privileged tool boundary",
        "task minimization",
        "validated findings admission"
      ],
      "mustNot": [
        "Read raw public web content",
        "Send secrets or private data to the web subagent",
        "Take privileged actions solely from unreviewed web findings"
      ]
    },
    {
      "id": "web-research-subagent",
      "name": "Web Research Subagent",
      "runtime": "sanitized subprocess worker",
      "path": "src/isolated-web-search-agent/web_subagent_worker.py",
      "trustLevel": "untrusted-input-facing",
      "capabilities": [
        "read-only search provider interface",
        "read-only fetch provider interface",
        "bounded research loop",
        "structured claims and citations"
      ],
      "mustNot": [
        "Receive credentials",
        "Write files or call privileged tools",
        "Return raw web page content to the main harness"
      ]
    }
  ],
  "contracts": [
    {
      "name": "ResearchTask",
      "path": "src/isolated-web-search-agent/isolation_contracts.py",
      "direction": "main harness to subagent",
      "controls": [
        "query size cap",
        "sensitive content detection",
        "allowed domain normalization",
        "iteration and fetch budgets"
      ]
    },
    {
      "name": "ResearchFindings",
      "path": "src/isolated-web-search-agent/isolation_contracts.py",
      "direction": "subagent to main harness",
      "controls": [
        "strict status set",
        "citation URL validation",
        "prompt-injection scan",
        "payload size cap",
        "raw content exclusion"
      ]
    }
  ]
}